{
  "expo": {
    "name": "StickerSmash",
    "slug": "StickerSmash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/presentacion/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/presentacion/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./google-services.json"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/presentacion/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
        "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./src/presentacion/assets/favicon.png",
      "googleServicesFile": "./google-services.json"
    }
  }
}
